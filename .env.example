# Postgres (Neon or Supabase)
DATABASE_URL=postgres://user:pass@host/db

# Google OAuth — app stays in Testing mode, one test user, gmail.readonly only
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/callback/google

# Session cookie signing secret (openssl rand -base64 32)
SESSION_SECRET=

# Email allowed to sign in (allow-list of one)
ALLOWED_EMAIL=

# 32-byte key, base64, for encrypting the Gmail refresh token at rest
TOKEN_ENCRYPTION_KEY=

# LLM used for classify + extract
ANTHROPIC_API_KEY=

# Web push (VAPID) — generate with `pnpm vapid`
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Shared secret the cron route checks
CRON_SECRET=

# Comma-separated sender domains that always get read (subdomains included)
AGENCY_DOMAINS=

# Models (defaults: classify claude-haiku-5-5, extract claude-opus-5-5)
CLASSIFY_MODEL=
EXTRACT_MODEL=

# Phase 2: bearer token an external agent runtime uses for /api/tools/*
AGENT_TOKEN=
